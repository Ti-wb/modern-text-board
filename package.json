{
  "name": "modern-text-board",
  "private": true,
  "version": "1.1.0",
  "description": "A lightweight, responsive, offline-ready text board and handheld sign PWA.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ti-wb/modern-text-board.git"
  },
  "homepage": "https://github.com/Ti-wb/modern-text-board#readme",
  "bugs": {
    "url": "https://github.com/Ti-wb/modern-text-board/issues"
  },
  "keywords": [
    "text-board",
    "handheld-sign",
    "handheld-board",
    "pwa",
    "preact"
  ],
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview:clean": "vite preview --outDir dist/experiments/marquee-clean",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:ab": "node scripts/perf-ab.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.4",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
